# Model id for the provider configured in src/agent/model.ts (currently OpenAI).
LLM_MODEL=gpt-5.5
LLM_API_KEY=
PORT=3000
LOG_LEVEL=info
# A2A agents (base URLs; the Agent Card is read from <url>/.well-known/agent-card.json).
INFORMATIONS_AGENT_URL=http://127.0.0.1:8001
ACTIONS_AGENT_URL=http://127.0.0.1:8002
# TODO(auth): every request acts as this client until real authentication exists.
DEMO_CLIENT_ID=c_001
