{
  "name": "bank-client-service",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts | node scripts/pretty-logs.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "type": "module",
  "dependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "@ai-sdk/openai": "^4.0.83",
    "ai": "^7.0.127",
    "express": "^5.2.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.21",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
